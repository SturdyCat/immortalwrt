# AX3000T 专属构建种子配置（make defconfig 会自动展开依赖）
#
# 基线：OpenWrt 25.12.6 官方 mediatek/filogic config.buildinfo
#       https://downloads.openwrt.org/releases/25.12.6/targets/mediatek/filogic/config.buildinfo
# 剪裁：官方是 BUILDBOT 全设备全量构建（364 个设备项 + ALL_KMODS + SDK/IB），
#       这里只保留 xiaomi_mi-router-ax3000t（stock layout）一台设备，
#       关闭全量构建项，主题只留 argon，并把设备上后装的插件改为固件内置。
# 设备：Xiaomi Mi Router AX3000T / mediatek-filogic / aarch64_cortex-a53
#       / squashfs + UBI stock layout（board_name = xiaomi,mi-router-ax3000t）

## ===== 目标设备：仅 AX3000T，不生成 ubootmod / 其它机型 =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=""
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod is not set

## ===== 关闭官方 buildbot 才会用到的全量构建项 =====
# CONFIG_BUILDBOT is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_DEVEL is not set
# CONFIG_SDK is not set
# CONFIG_SDK_LLVM_BPF is not set
# CONFIG_IB is not set
# CONFIG_IMAGEOPT is not set
# CONFIG_MAKE_TOOLCHAIN is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_REPRODUCIBLE_DEBUG_INFO is not set
# CONFIG_JSON_CYCLONEDX_SBOM is not set
# CONFIG_AUTOREMOVE is not set

## ===== 根文件系统：只做 squashfs（AX3000T 用 squashfs + UBI） =====
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EROFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_JFFS2_NAND is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# 保留 initramfs 默认值：会额外产出 initramfs-factory.ubi / initramfs-kernel.bin
# 用于首次刷入或救砖；日常升级用 squashfs-sysupgrade.bin。

## ===== LuCI 基础：照搬官方组件集，主题只留 argon =====
# 下列 CONFIG_PACKAGE_* 逐项对齐官方 config.buildinfo 的 LuCI 组件集，
# 仅做了两处删减：去掉设备未使用的 luci-ssl / px5g-mbedtls，
# 并把 luci-theme-bootstrap 换成当前在用的 luci-theme-argon。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# bootstrap / footstrap / material 的源码已由 scripts/ax3000t-prune.sh 删除，
# 且 luci-light 的 +luci-theme-bootstrap 强依赖已被改指向 argon。

## ===== 设备上当前在用的插件：由后装改为固件内置 =====
# OpenClash：依赖自动带入 ruby / bash / curl / ip-full / unzip /
#            luci-compat / dnsmasq-full / kmod-tun / kmod-nft-tproxy / kmod-inet-diag
CONFIG_PACKAGE_luci-app-openclash=y
# rtp2httpd：IPTV 组播转 HTTP，依赖自动带入 rtp2httpd
CONFIG_PACKAGE_luci-app-rtp2httpd=y
# zram 交换（设备后装），依赖自动带入 kmod-zram 等
CONFIG_PACKAGE_zram-swap=y
# 其余后装工具，显式列出便于核对
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y

## ===== 简体中文语言包（对齐设备当前已装项） =====
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

## ===== zram：保留 lz4 + zstd 两个后端，去掉 lzo，默认压缩器 lz4 =====
# 符号来自 package/kernel/linux/modules/other.mk 的 KernelPackage/zram/config。
# 设备当前 UCI 写的是 zram_comp_algo='zstd'，但旧固件只编了 LZO 后端，
# /sys/block/zram0/comp_algorithm 实测只有 "[lzo-rle] lzo"，该配置一直空转。
# 新固件同时提供 lz4 与 zstd，zstd 才真正可用；默认压缩器仍取 CPU 最轻的 lz4。
# 想换成高压缩比的 zstd：把下面 DEF_COMP_LZ4 换成 DEF_COMP_ZSTD 重新编译即可，
# 或直接改设备 UCI（zram 一旦 swapon 就不能热切换算法，必须 swapoff + reset）。
#
# KERNEL_ZRAM_BACKEND_FORCE_LZO 是 def_bool !LZ4&&!LZ4HC&&!ZSTD，
# 启用 LZ4 / ZSTD 后它自动为 n，不会再 select LZO，无需在配置里显式声明；
# 该符号是 OpenWrt 层的，写进种子配置反而会被映射成内核里不存在的符号。
# 压缩库依赖由 kmod-zram 的 DEPENDS 自动带入：kmod-lib-lz4（模块）、
# kmod-lib-zstd（zstd 库在 filogic config 里已是 built-in，该包为空元包）。
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y
# CONFIG_KERNEL_ZRAM_BACKEND_LZO is not set
# CONFIG_KERNEL_ZRAM_BACKEND_LZ4HC is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZO is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4HC is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD is not set

## ===== 内核调试 / 诊断代码：全部关闭，减少内核常驻占用 =====
# 这些是 OpenWrt 官方 Config-kernel.in 里的 CONFIG_KERNEL_* 开关，会覆盖内核默认 y。
# 与 scripts/ax3000t-prune.sh 第 5 步（内核配置剪裁）配套使用。
# 代价：内核 oops 日志不再有函数名、无法用 perf / kprobe 排障，家用场景可接受。
#
# 注意：CGROUPS / NAMESPACES / SECCOMP / OVERLAY_FS 必须保留 —— procd ujail
#       服务隔离与 squashfs+overlay 根文件系统依赖它们，不能因为"不用 Docker"就关。
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_PRINTK_TIME is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_ELF_CORE is not set
# CONFIG_KERNEL_PERF_EVENTS is not set
# CONFIG_KERNEL_PROC_KCORE is not set
# CONFIG_KERNEL_KPROBES is not set
# CONFIG_KERNEL_FTRACE is not set
# CONFIG_KERNEL_PROFILING is not set

## ===== 明确不用的重型服务：显式排除，防止间接依赖带回固件 =====
# 实机核实（ssh root@192.168.99.1）：Docker/Containerd、Tailscale、ZeroTier、
# mwan3 的包、init.d 脚本、UCI 配置、进程均不存在；网络是单 WAN
# （wan.1001 = PPPoE，wan.3800 = IPTV VLAN 且 proto none），无多 WAN 需求。
# 这里显式写 not set，并由 workflow 在 make defconfig 后做守卫校验；
# 不物理删除 feed 包目录，避免 feeds install -a 的依赖解析告警。
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_luci-app-docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_luci-app-tailscale-community is not set
# CONFIG_PACKAGE_zerotier is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_mwan3 is not set
# CONFIG_PACKAGE_luci-app-mwan3 is not set
